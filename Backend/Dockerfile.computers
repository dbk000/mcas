FROM python:3.12-slim

WORKDIR /backend

COPY requirements-computers.txt /backend/requirements.txt
RUN pip install --no-cache-dir -r /backend/requirements.txt

COPY core_logic /backend/core_logic
COPY governance /backend/governance
COPY indicators /backend/indicators
COPY scripts /backend/scripts
COPY computers /backend/computers
COPY config /backend/config

ENV PYTHONPATH=/backend:/backend/scripts

CMD ["python", "-u", "computers/main.py"]
