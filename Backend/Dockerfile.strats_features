FROM python:3.12-slim

WORKDIR /backend

COPY requirements-strats-features.txt /backend/requirements.txt
RUN pip install --no-cache-dir -r /backend/requirements.txt

COPY core_logic /backend/core_logic
COPY governance /backend/governance
COPY indicators /backend/indicators
COPY strats_features /backend/strats_features

ENV PYTHONPATH=/backend

CMD ["python", "-u", "strats_features/main.py"]
