POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://trading:change_me@postgres:5432/trading

# API Settings
API_KEY=change_me_to_64_char_hex

# Universe Settings
DEFAULT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
SYMBOL_COUNT=200
USE_DYNAMIC_SYMBOLS=false

# Signal Settings  
SIGNAL_TOP_N_DAILY=10

# Worker scaling (for indicator_worker / signal_worker)
WORKER_INDEX=0
N_WORKERS=1

# Ingestor
SEED_WORKERS=20

# Logging
LOG_LEVEL=INFO

# S1 Challenger thresholds (remove to use canonical Champion defaults: 10.0, 5, 0.70, 0.30, 1.5)
# S1_BB_WIDTH_PCTILE_TRIGGER=20.0
# S1_SQUEEZE_AGE_MIN=3
# S1_CLV_TH_LONG=0.60
# S1_CLV_TH_SHORT=0.40
# S1_VOLUME_Z_MIN=1.0

# S2 Challenger thresholds (remove to use canonical Champion defaults: 20, 0.60, 4.0, 1.0, 1.0)
# S2_N_CONV=40
# S2_CONV_DOWN_MIN_FRAC=0.50
# S2_GAP_WIDE_ATR=2.0
# S2_GAP_NARROW_ATR=1.5
# S2_VOLUME_Z_MIN=0.75
