POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://trading:change_me@postgres:5432/trading

# API Settings
API_KEY=change_me_to_64_char_hex

# Universe Settings
DEFAULT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
SYMBOL_COUNT=200
USE_DYNAMIC_SYMBOLS=false

# Two-tier Universe (Canon §1.4C)
# Known Universe: top N USDT pairs by 24h volume. OHLCV ingested hourly.
KNOWN_UNIVERSE_SIZE=1024
# Monitored Universe: subset of Known filtered by this threshold. Gets WS + full pipeline.
# Set to 0 to monitor all known symbols (Phase 1 backward-compat mode).
MIN_24H_QUOTE_VOLUME_USD=5000000

# Signal Settings  
SIGNAL_TOP_N_DAILY=10

# Worker scaling (for indicator_worker / signal_worker)
WORKER_INDEX=0
N_WORKERS=1

# Ingestor
SEED_WORKERS=20

# Logging
LOG_LEVEL=INFO

# S1 overrides (code defaults are tuned: bb_pctile=5.0, clv_long=0.75, vol_z=2.0)
# S1_BB_WIDTH_PCTILE_TRIGGER=5.0
# S1_SQUEEZE_AGE_MIN=5
# S1_CLV_TH_LONG=0.75
# S1_CLV_TH_SHORT=0.30
# S1_VOLUME_Z_MIN=2.0

# S2 overrides (code defaults are tuned: clv=0.70, vol_z=2.0)
# S2_N_CONV=40
# S2_CONV_DOWN_MIN_FRAC=0.50
# S2_GAP_WIDE_ATR=2.0
# S2_GAP_NARROW_ATR=1.5
# S2_VOLUME_Z_MIN=2.0

# S3 overrides (RSI Divergence Reversal)
# S3_PIVOT_LOOKBACK=50
# S3_MIN_SPAN_BARS=5
# S3_MAX_SPAN_BARS=40
# S3_CLV_TH=0.65
# S3_VOLUME_Z_MIN=1.2
# S3_RSI_SLOPE_FADE_TH=0.0

# S4 overrides (VWAP Reversion — intraday only)
# S4_EXTENSION_TH_ATR=2.0
# S4_EXTENSION_PCTILE_MIN=90.0
# S4_CLV_TH=0.65
# S4_VOLUME_Z_MIN=1.0

# S5 overrides (S/R Breakout)
# S5_CLUSTER_ATR_MULT=0.5
# S5_MIN_TOUCHES=3
# S5_LOOKBACK_BARS=100
# S5_CLV_TH=0.70
# S5_VOLUME_Z_MIN=1.5

# S6 overrides (Trend Continuation Pullback)
# S6_SLOPE_MIN=0.01
# S6_CLV_TH=0.65
# S6_VOLUME_Z_MIN=1.5
# S6_PULLBACK_LOOKBACK=5

# S7 overrides (Momentum Breakout Donchian)
# S7_CLV_TH_LONG=0.70
# S7_CLV_TH_SHORT=0.30
# S7_VOLUME_Z_MIN=1.5

# Active setup IDs (comma-separated). All 7 setups + U1 available.
# SETUP_IDS=S1,S2,S3,S4,S5,S6,S7,U1
