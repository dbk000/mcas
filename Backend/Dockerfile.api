FROM python:3.12-slim
WORKDIR /backend
COPY requirements-api.txt /backend/requirements.txt
RUN pip install --no-cache-dir -r /backend/requirements.txt
COPY core_logic /backend/core_logic
COPY governance /backend/governance
COPY indicators /backend/indicators
COPY api /backend/api
ENV PYTHONPATH=/backend
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
