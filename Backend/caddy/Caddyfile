{
  log {
    format json
    level INFO
    output stdout
  }
}

# Replace with your actual domain (requires DNS A record → VPS IP)
# Caddy auto-provisions HTTPS via Let's Encrypt
api.mcasui.com {
  log {
    format json
    level INFO
    output stdout
  }

  # CORS handled by FastAPI middleware (multi-origin aware)
  # Do NOT set CORS headers here — Caddy would overwrite FastAPI's dynamic origin

  handle /health {
    reverse_proxy api:8000
  }

  handle /v1/* {
    reverse_proxy api:8000
  }

  handle {
    respond "MCAS API" 200
  }
}

# Keep local HTTP access for Docker internal use
:80 {
  # Chaos Failure Injection (Workstream 2)
  @chaos_500 {
    header X-Chaos-Status 500
  }
  handle @chaos_500 {
    respond "Chaos Error 500" 500
  }

  @chaos_403 {
    header X-Chaos-Status 403
  }
  handle @chaos_403 {
    respond "Chaos Forbidden 403" 403
  }

  handle /health {
    reverse_proxy api:8000
  }

  handle /v1/* {
    reverse_proxy api:8000
  }

  handle {
    respond "Trading API alive" 200
  }
}
